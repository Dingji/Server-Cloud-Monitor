{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "disabled_providers": [
    "opencode-go"
  ],
  "model": "relay-go/mimo-v2.6-flash",
  "providers": {
    "relay-go": {
      "name": "OpenCode Go (relay)",
      "env": [
        "OPENCODE_RELAY_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://8.153.153.176/v1"
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "headers": {
            "X-Relay-Model": "deepseek-v4.1-flash"
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          }
        },
        "mimo-v2.6-flash": {
          "name": "MiMo V2.6 Flash",
          "headers": {
            "X-Relay-Model": "mimo-v2.6-flash"
          },
          "limit": {
            "context": 1048576,
            "output": 131072
          }
        }
      }
    },
    "relay-zen": {
      "name": "OpenCode Zen (relay)",
      "canonical": "opencode",
      "env": [
        "OPENCODE_RELAY_KEY"
      ],
      "settings": {
        "baseURL": "http://8.153.153.176/zen/v1"
      },
      "models": {
        "qwen3.8-flash": {
          "name": "Zen · Qwen3.8 Flash (paid) · needs Zen funds",
          "headers": {
            "X-Relay-Model": "qwen3.8-flash"
          },
          "limit": {
            "context": 262144,
            "output": 32768
          },
          "disabled": true
        },
        "deepseek-v4.1-flash": {
          "name": "Zen · DeepSeek V4.1 Flash (paid) · needs Zen funds",
          "headers": {
            "X-Relay-Model": "deepseek-v4.1-flash"
          },
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "disabled": true
        },
        "glm-5.3-flash": {
          "name": "Zen · GLM 5.3 Flash (paid) · needs Zen funds",
          "headers": {
            "X-Relay-Model": "glm-5.3-flash"
          },
          "limit": {
            "context": 200000,
            "output": 32768
          },
          "disabled": true
        },
        "mistral-large-4": {
          "name": "Zen · Mistral Large 4 (paid) · needs Zen funds",
          "headers": {
            "X-Relay-Model": "mistral-large-4"
          },
          "disabled": true
        },
        "gpt-6.1-sol": {
          "name": "Zen · GPT 6.1 Sol (paid) · needs Zen funds",
          "headers": {
            "X-Relay-Model": "gpt-6.1-sol"
          },
          "disabled": true
        },
        "claude-opus-5-5-backup": {
          "name": "Zen · Claude Opus 5.5 Backup (paid) · needs Zen funds",
          "headers": {
            "X-Relay-Model": "claude-opus-5-5-backup"
          },
          "disabled": true
        }
      }
    }
  }
}
