# Never commit live server secrets or runtime state
config.json
keys/
*.pem
*.key
backups/
logs/
tmp/
runtime/
node_modules/
.env
cloud-monitor.env
# device-agent registry (per-host tokens)
devices.json
port_usage.json

# RelayHub host state and large binaries (deploy.sh fetches frp per architecture)
relayhub/frps
relayhub/frps.toml
relayhub/downloads/
relayhub/panel/mappings.json
relayhub/**/__pycache__/
relayhub/**/*.pyc

# Local build/verify scratch
builddir/
boottest/

# Kotlin / Gradle client (client/)
client/.gradle/
client/**/build/
client/.kotlin/
client/local.properties
client/.toolchain/
client/**/*.apk
client/**/*.aab
client/**/*.msi
client/**/*.deb
client/**/*.dmg
client/captures/
client/*.log

# NoteBox server runtime
notebox/**/__pycache__/
notebox/**/*.pyc
notebox/**/venv/
notebox/**/data/
notebox/**/*.db
