# 行尾统一：仓库里存 LF，避免 Windows 上 core.autocrlf 把 shell 脚本变成 CRLF
# （install.sh / deploy.sh 带 CRLF 会在 Linux 上因 \r 直接跑不起来）
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.ini       text eol=lf
*.tsv       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.kt        text eol=lf
*.kts       text eol=lf
*.xml       text eol=lf
*.swift     text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# 二进制
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       text eol=lf
*.ttf       binary
*.woff2     binary
*.tar.gz    binary
*.gz        binary
*.zip       binary
*.apk       binary
*.aab       binary
*.msi       binary
*.deb       binary
*.dmg       binary
*.p12       binary
*.jks       binary
*.keystore  binary
frps        binary
frpc        binary
